# ===== LLM（可选）=====
# 服务端持有的 API Key。不配置时：用户可在界面「设置」里填自己的 Key（BYOK，不落盘），
# 或直接使用内置「演示模式」（模板智能体，无需任何 Key 即可完整体验主流程）。
# 支持两种供应商：
#   1) 官方 Anthropic：只填 ANTHROPIC_API_KEY（sk-ant-...），模型默认 claude-opus-5-5
#   2) 智谱 GLM（Anthropic 兼容端点）：填 ANTHROPIC_API_KEY（智谱 Key，id.secret 格式）
#      并取消注释下面两行：
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
# AGENT_MODEL=glm-5.1  # glm-5.3 强制长思考，实时生成场景不适用
# 单次生成 max_tokens 上限
AGENT_MAX_TOKENS=

# ===== 持久化 =====
# 推荐（Vercel 等 Serverless 部署）：Upstash Redis 免费档（https://upstash.com）
# 两者都配置时启用 Redis 适配器；否则使用本地 JSON 文件（DATA_DIR），文件不可写时退回内存
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
DATA_DIR=

# ===== 安全 =====
# 会话 Cookie 签名密钥，生产环境务必设置随机长字符串
AUTH_SECRET=
