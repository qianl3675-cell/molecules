# ===== LLM（可选）=====
# 服务端持有的 Anthropic API Key。不配置时：用户可在界面「设置」里填自己的 Key（BYOK，不落盘），
# 或直接使用内置「演示模式」（模板智能体，无需任何 Key 即可完整体验主流程）。
ANTHROPIC_API_KEY=
# 生成模型（留空使用代码内默认值）
AGENT_MODEL=
# 单次生成 max_tokens 上限
AGENT_MAX_TOKENS=

# ===== 持久化 =====
# 推荐（Vercel 等 Serverless 部署）：Upstash Redis 免费档（https://upstash.com）
# 两者都配置时启用 Redis 适配器；否则使用本地 JSON 文件（DATA_DIR），文件不可写时退回内存
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
DATA_DIR=

# ===== 安全 =====
# 会话 Cookie 签名密钥，生产环境务必设置随机长字符串
AUTH_SECRET=
